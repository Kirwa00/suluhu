# TLS is issued by Let's Encrypt over HTTP-01, which works behind a proxied
# Cloudflare record as long as Cloudflare's SSL mode is "Full (strict)".
#
# WEB_DOMAIN_REDIRECT is a secondary domain that 301-redirects to WEB_DOMAIN
# (e.g. the .com when WEB_DOMAIN is the .co.ke). If you only have one domain,
# delete this block and the WEB_DOMAIN_REDIRECT line from your env file.
{$WEB_DOMAIN_REDIRECT} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}
